{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showmate-preview",
  "account_id": "4a7746df73b55fffd82c3f3901371a76",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ShowMateRoom",
        "class_name": "ShowMateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ShowMateRoom"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showmate-db",
      "database_id": "7120ae10-72e3-43a0-a1fc-296e9d33fcb9",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "bac84ff689a24890b7826919907240d2"
    }
  ],
  "vectorize": [
    {
      "binding": "SHOW_VECTORS",
      "index_name": "showmate-shows"
    }
  ],
  "workflows": [
    {
      "binding": "POST_MATCH_WORKFLOW",
      "name": "showmate-preview-post-match",
      "class_name": "PostMatchWorkflow"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "showmate_events"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 10 * * *"
    ]
  }
}
