{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showmate",
  "account_id": "88c90ea29992c85c07a14e973fbee4ec",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-22",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ShowMateRoom",
        "class_name": "ShowMateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ShowMateRoom"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showmate-db",
      "database_id": "109ac237-c93f-4ab0-af87-799c4b08e90f",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b330904467f246fa86fda92867b5afb4"
    }
  ],
  "vectorize": [
    {
      "binding": "SHOW_VECTORS",
      "index_name": "showmate-shows"
    }
  ],
  "workflows": [
    {
      "binding": "POST_MATCH_WORKFLOW",
      "name": "showmate-post-match",
      "class_name": "PostMatchWorkflow"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "showmate_events"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 10 * * *"
    ]
  }
}
