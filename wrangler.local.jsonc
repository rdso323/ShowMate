{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showmate-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-07",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ShowMateRoom",
        "class_name": "ShowMateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShowMateRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showmate-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "workflows": [
    {
      "binding": "POST_MATCH_WORKFLOW",
      "name": "showmate-post-match",
      "class_name": "PostMatchWorkflow"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "showmate_events"
    }
  ]
}
