{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showmate",
  "account_id": "16ff63b70f38fa997b2daf912776dfa7",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ShowMateRoom",
        "class_name": "ShowMateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShowMateRoom"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showmate-db",
      "database_id": "364af56f-798a-47b0-bfa0-c4e2b735cdb6",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "f4086ea1e7d547b78ebdcea28ea90ec5"
    }
  ],
  "vectorize": [
    {
      "binding": "SHOW_VECTORS",
      "index_name": "showmate-shows"
    }
  ],
  "workflows": [
    {
      "binding": "POST_MATCH_WORKFLOW",
      "name": "showmate-post-match",
      "class_name": "PostMatchWorkflow"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "showmate_events"
    }
  ],
  "observability": {
    "enabled": true
  }
}
