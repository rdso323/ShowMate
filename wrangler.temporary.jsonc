{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showmate-preview",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ShowMateRoom",
        "class_name": "ShowMateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShowMateRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showmate-preview-db",
      "database_id": "c2dfceb1-f81d-4df7-915c-3d0c3776dfd3",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "f5b9e18293ab458eb86e9fc947e079e1"
    }
  ],
  "workflows": [
    {
      "binding": "POST_MATCH_WORKFLOW",
      "name": "showmate-preview-post-match",
      "class_name": "PostMatchWorkflow"
    }
  ]
}
